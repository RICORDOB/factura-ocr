# Modo de OCR: "mock" (datos de ejemplo, sin API) o "google" (Document AI real)
OCR_MODE=mock

# === Credenciales Google Document AI (solo necesarias con OCR_MODE=google) ===
# Ruta absoluta al JSON de la service account
GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/clave.json
DOCUMENT_AI_PROJECT_ID=tu-proyecto
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=tu-processor-id

# === Configuración de la app ===
# Ruta del archivo Excel (se crea automáticamente en la primera carga)
EXCEL_PATH=./data/base_facturas.xlsx
